# ---------------------------------------------------------------------------
# 运行时作用域 · 示意参考环境变量（不可直接部署）
# ---------------------------------------------------------------------------
# 文件解析格式：POSIX shell assignment。
# scope 值解析格式：JSON array string（服务读取环境变量后再做 JSON 解析）。
# 标量使用双引号；JSON 数组使用单引号包住整个字符串。
# 替换全部 <placeholder> 后，可由 sh / bash / zsh 读取。
# 不要把仍带占位符的文件当作真实实例配置发布。
#
# 这些变量表达应用层治理策略，不是操作系统级安全隔离。
# 能改启动配置或绕过服务直接读库的进程，已经越过本模板的边界。
#
# 详见 templates/README.md 与 docs/05-身份与作用域隔离.md
#
# 注意：变量前缀取决于你使用的记忆库，此处统一写作 MEMORY_ 作为占位。


# ===========================================================================
# 客户端 A
# ===========================================================================

# --- 归属 ---
# 启动时与本机正式 owner 常量比对，不一致直接退出。
MEMORY_USER_ID="<owner-id>"

# --- 来源标识（写入时由服务端盖章，调用方无法覆盖）---
MEMORY_AGENT_ID="<client-a>"
MEMORY_SOURCE_SYSTEM="<client-a>"
MEMORY_SOURCE_PLATFORM="local"
MEMORY_SOURCE_PROFILE="<client-a-profile>"

# --- 读侧白名单 ---
# 本进程只能召回 applies_to 命中此列表的记忆。
# 客户端 A 看不到 platform:<client-b> 的专属记忆。
MEMORY_RUNTIME_SCOPES='["universal","platform:<client-a>"]'

# --- 写侧默认值 ---
# 写入时未指定 applies_to，即被钉在本平台，不会意外变成 universal。
# 调用方声明的范围必须是 RUNTIME_SCOPES 的子集，不能自行扩权。
MEMORY_DEFAULT_APPLIES_TO='["platform:<client-a>"]'


# ===========================================================================
# 客户端 B —— 同一个二进制，只换 scope
# ===========================================================================

# MEMORY_USER_ID="<owner-id>"
# MEMORY_AGENT_ID="<client-b>"
# MEMORY_SOURCE_SYSTEM="<client-b>"
# MEMORY_SOURCE_PLATFORM="local"
# MEMORY_SOURCE_PROFILE="<client-b-profile>"
# MEMORY_RUNTIME_SCOPES='["universal","platform:<client-b>"]'
# MEMORY_DEFAULT_APPLIES_TO='["platform:<client-b>"]'


# ===========================================================================
# 合法的作用域取值（封闭枚举）
# ===========================================================================
#
#   universal              跨全部 AI 共享
#   platform:<name>        某个 AI 客户端专属
#   profile:<name>         某个机器人配置 / 角色专属
#   project:<stable-id>    某个项目专属
#
# 遇到不认识的值 —— 报错，而不是当成 universal。
# 「不知道该给谁看」的默认值是「谁都别看」，不是「谁都能看」。
# 早期没有作用域字段的历史记录，同样不提升为 universal。


# ===========================================================================
# 必须在启动时清掉的变量
# ===========================================================================
#
# 管理模式开关 —— 在当前参考设计里，它允许进入显式审计旁路。
# 危险在于「继承」：某个客户端进程环境里恰好有它，
# 启动的记忆进程就会继承过去，于是该客户端在毫不知情的情况下获得了旁路能力。
#
# CLI 包装脚本、MCP 服务进程、网关插件调起子进程 —— 三处入口都要清：
#
#   unset MEMORY_ADMIN_MODE                 # shell
#   os.environ.pop("MEMORY_ADMIN_MODE", None)   # 服务进程启动时
#   env.pop("MEMORY_ADMIN_MODE", None)          # 构造子进程环境时
#
# 独立的审核管理入口可在受控人工流程中设置该变量。
# 环境变量本身不证明操作者身份；管理入口仍需独立鉴权和审计。


# ===========================================================================
# 同样必须清掉的：云端凭据与代理
# ===========================================================================
#
#   unset OPENAI_API_KEY
#   unset ALL_PROXY all_proxy HTTP_PROXY http_proxy HTTPS_PROXY https_proxy no_proxy
#   unset PYTHONPATH PYTHONHOME VIRTUAL_ENV
#
# 清 API key 的作用不是省钱，是堵死降级路径：
# 本地嵌入服务挂掉时，某些库会「贴心地」自动回退到云端，
# 于是本次调用涉及的记忆内容可能在你不知情时被发到云端。
# 清掉已知 key 后，本地故障应显式失败，不应沿该变量回退到云端。
# 这不证明其它配置文件、依赖库或网络路径中不存在凭据。
#
# 清 PYTHONPATH 是因为这个脚本会被各种客户端从各种环境里调起来，
# 继承过去的路径会让它导入到错误的包——报错发生在第一行 import，
# 看起来像是脚本本身坏了，排查起来极其痛苦。


# ===========================================================================
# IM 平台鉴权白名单（仅网关侧需要）
# ===========================================================================
#
# 本地 CLI / MCP 没有「发送者」概念，只需校验 owner 常量。
# 只有通过 IM 平台接收消息的网关才需要下面这些。
#
# PLATFORM_A_ALLOWED_USERS="<id-1>,<id-2>"
# PLATFORM_A_ALLOW_ALL_USERS="false"
# PLATFORM_A_GROUP_POLICY="disabled"
#
# 白名单解析必须显式剔除通配符 "*"：
#
#   allowed.update(v.strip() for v in raw.split(",")
#                  if v.strip() and v.strip() != "*")
#
# 如果网关把通配符当作授权，未验证发送者可能获得机主记忆能力。
